{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "MaimsDb": "Server=localhost;Port=3306;Database=maims;User=maims_app;Password=Change;CharSet=utf8mb4;SslMode=None;AllowPublicKeyRetrieval=True;Pooling=true;MinimumPoolSize=5;MaximumPoolSize=100;"
  },
  "App": {
    "Name": "MAIMS",
    "Version": "0.1.0",
    "SessionTimeoutMinutes": 15,
    "MaxAttachmentSizeBytes": 10485760
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/maims-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 } }
    ]
  }
}
